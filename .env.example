# ==========================================
# ZESTMED Supabase PostgreSQL Configuration
# ==========================================

# Your Supabase Project URL (found in Project Settings -> Data API or by clicking 'Connect' at top)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Anonymous Public / Publishable API Key (found in Project Settings -> API Keys)
# Supports both legacy JWT anon key (eyJ...) and new Supabase publishable key (sb_publishable_...)
VITE_SUPABASE_ANON_KEY=sb_publishable_your_key_here
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Optional: Supabase Direct PostgreSQL Database Connection String (for backend scripts or migrations)
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:5432/postgres

# ==========================================
# Razorpay Payment Gateway Configuration
# ==========================================
# Server-side environment variables (Private - Node.js Backend only)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here

# Client-side environment variables (Public Key ID for Razorpay Checkout script)
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id_here
